# ============================================================
# GradNavi Backend Environment Example
# ============================================================
#
# Copy this file to:
#
#   backend/.env
#
# Do not commit real credentials or API keys.
# Values below are examples/placeholders only.
# ============================================================


# ------------------------------------------------------------
# Django
# ------------------------------------------------------------

# Required by backend/gradnavi/settings.py.
SECRET_KEY=replace-with-a-local-development-secret



# Local development defaults to True.
# Railway production should set this to False.
DEBUG=True

# Comma-separated hostnames, without http:// or https://.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins including scheme.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty locally unless required.
# Production origins can be supplied through Railway.
CSRF_TRUSTED_ORIGINS=


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_NAME=gradnavi_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432


# ------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------

# Required when GradNavi performs OpenAI-backed operations.
#
# The API key is loaded by the Django backend only.
# Never expose this value through React or commit a real API key.
#
# Current OpenAI-backed operations include:
# - Recommendation embeddings
# - Career guidance text generation
# - Resume generation
# - Cover letter generation
# - Interview question generation
# - Interview feedback
# - Approved learning-resource AI operations
OPENAI_API_KEY=


# Optional text-generation model override.
#
# Current backend text-provider default:
#   gpt-5-nano
#
# Used by approved structured text-generation flows including:
# - Top Match career explanation
# - AI Gap Summary
# - Resume generation
# - Cover letter generation
# - Interview question generation
# - Interview feedback
#
# If omitted, the backend text provider defaults to gpt-5-nano.
OPENAI_TEXT_MODEL=gpt-5-nano
# Email
# Local development uses the console backend.
# Production should configure a real email backend and SMTP credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
