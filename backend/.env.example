# ============================================================
# GradNavi Backend Environment Example
# ============================================================
#
# Copy this file to:
#
#   backend/.env
#
# Do not commit real credentials or API keys.
# Values below are examples/placeholders only.
# ============================================================


# ------------------------------------------------------------
# Django
# ------------------------------------------------------------

# Required by backend/gradnavi/settings.py.
SECRET_KEY=replace-with-a-local-development-secret


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_NAME=gradnavi_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432


# ------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------

# Required when GradNavi performs OpenAI-backed operations,
# including recommendation embeddings and approved WBS 5.6
# text-generation operations.
#
# Never commit a real API key.
OPENAI_API_KEY=


# Optional text-generation model override.
#
# Current WBS 5.6 default:
#   gpt-5-nano
#
# Used for:
# - Top Match career explanation
# - AI Gap Summary
#
# If omitted, the backend text provider defaults to gpt-5-nano.
OPENAI_TEXT_MODEL=gpt-5-nano
